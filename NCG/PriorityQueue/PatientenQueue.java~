
/**
 * Die Klasse PatientenQueue stellt eine priorisierte Wartezimmer<br>
 * zur Verfuegung
 * 
 * @author Sven Hees 
 * @version 2015-01-21
 */
public class PatientenQueue extends PriorityQueue<Patient>
{
    //Attribute
    ListGUI gui;
    //Konstruktor
    /**
     * Konstruktor fuer Objekte der Klasse PatientenQueue
     */
    public PatientenQueue()
    {
        
    }

    //Methoden
    /**
     * Wenn der Patienten mit dem uebergebenen Namen in der Warteschlange<br>
     * enthalten ist, wird er entfernt.
     * @param Patientenname (String)
     */
    public void remove(String pName)
    {
        dieListe.toFirst();
        while(!dieListe.getContent().gibName().equals(pName) && dieListe.hasAccess()) {
            dieListe.next();
        }
        if(dieListe.hasAccess()) {
            int p = dieListe.getContent().gibPriority();
            dieListe.remove();
            iAnz--;
            lPriorityAnz.toFirst();
            for(int i=0; i<p; i++) {
                lPriorityAnz.next();
            }
            lPriorityAnz.setContent(lPriorityAnz.getContent()-1);
        }
    }

    /**
     * Wenn der Patient mit dem uebergebenen Namen in der Warteschlange<br>
     * enthalten ist, wird die Prioritaet auf die uebergebene geaendert.
     * @param Patientenname (String)<br>
     *        neue Prioritaet (int)
     */
    public void aenderePrioritaet(String pName, int pPrio)
    {
        dieListe.toFirst();
        while(!dieListe.getContent().gibName().equals(pName) && dieListe.hasAccess()) {
            dieListe.next();
        }
        if(dieListe.hasAccess()) {
            remove(pName);
            Patient p = new Patient(pPrio, pName);
            insert(p);
        }
    }
}
